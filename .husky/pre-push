#!/bin/sh

echo "Checking workspace changes before pushing..."

# 1. Check if files inside the API folder changed
if git diff --name-only origin/main HEAD | grep -q "^apps/api/"; then
  echo "⚠️ Changes detected in apps/api. Running backend lint..."
  pnpm --filter api lint || exit 1
fi

# 2. Check if files inside the Web folder changed
if git diff --name-only origin/main HEAD | grep -q "^apps/web/"; then
  echo "⚠️ Changes detected in apps/web. Running frontend lint..."
  pnpm --filter web lint || exit 1
fi

echo "✅ All clean! Proceeding with push."