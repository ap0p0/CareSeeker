{
  "name": "careseeker",
  "private": true,
  "engines": {
    "node": "24.18.0"
  },
  "packageManager": "pnpm@11.0.0",
  "scripts": {
    "dev": "pnpm -r dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "start:api": "pnpm --filter api start:dev",
    "start:core": "pnpm --filter web start:core",
    "start:client": "pnpm --filter web start:client",
    "start:seeker": "pnpm --filter web start:seeker",
    "start:provider": "pnpm --filter web start:provider",
    "start:admin": "pnpm --filter web start:admin",
    "start:all": "pnpm --filter web start:all",
    "prepare": "husky",
    "format:check": "prettier --check ."
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@nestjs/core",
      "@prisma/engines",
      "esbuild",
      "prisma",
      "unrs-resolver"
    ]
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^15.4.3",
    "prettier": "3.5.2"
  },
  "lint-staged": {
    "**/*.{js,jsx,ts,tsx,json,css,md}": [
      "prettier --write"
    ]
  }
}
