// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  SEEKER
  PROVIDER
  ADMIN
}

/// Provider verification state. Only relevant when role = PROVIDER.
/// Admins manage this via backend; never self-assignable.
enum ProviderVerificationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PresignupType {
  SEEKER
  PROVIDER
}

enum ProviderProfileStatus {
  ACTIVE
  BLOCKED
  PENDING_VERIFICATION
}

enum CareRequestStatus {
  PENDING
  ACCEPTED
  REJECTED
  COMPLETED
}

enum ProviderVerificationRecordStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum NotificationType {
  GENERAL
  JOB
  MESSAGE
  PAYMENT
  REVIEW
}

/// Application-level user. Exists because Supabase auth.users only handles
/// authentication (identity). Roles, verification, and app-specific state
/// live here and are controlled server-side.
///
/// - id: Same UUID as Supabase auth.users.id (`@db.Uuid`). After migrating, run
///   `prisma/manual/supabase_user_fk.sql` on Supabase to add FK → auth.users(id).
/// - role: Application role; admin is NEVER self-assignable (enforced on create/update)
/// - providerVerificationStatus: For providers only; null for seeker/admin
model User {
  id                         String                     @id @db.Uuid // auth.users.id
  email                      String
  username                   String                     @unique
  name                       String
  surname                    String
  role                       UserRole                   @default(SEEKER)
  providerVerificationStatus ProviderVerificationStatus?

  providerAvailabilities ProviderAvailability[] @relation("provider_availability_provider")
  providedCareRequests   CareRequest[]          @relation("care_request_provider")
  seekerCareRequests     CareRequest[]          @relation("care_request_seeker")
  providedReviews        Review[]               @relation("review_provider")
  seekerReviews          Review[]               @relation("review_seeker")
  providerVerifications  ProviderVerification[] @relation("provider_verification_provider")
  notifications          Notification[]
  payments               Payment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Presignup {
  id       String        @id @default(cuid())
  type     PresignupType
  name     String
  surname  String
  email    String        @unique
  state    String?
  city     String?
  phone    String?
  accepted Boolean

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("presignups")
}

model ProviderAvailability {
  id         String    @id @default(uuid()) @db.Uuid
  providerId String    @map("provider_id") @db.Uuid
  dayOfWeek  Int?      @map("day_of_week")
  date       DateTime? @db.Date
  startTime  String    @map("start_time")
  endTime    String    @map("end_time")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  provider User @relation("provider_availability_provider", fields: [providerId], references: [id], onDelete: Cascade)

  @@index([providerId])
  @@index([providerId, dayOfWeek])
  @@index([providerId, date])
  @@map("provider_availability")
}

model CareRequest {
  id           String            @id @default(uuid()) @db.Uuid
  providerId   String            @map("provider_id") @db.Uuid
  careSeekerId String            @map("care_seeker_id") @db.Uuid
  status       CareRequestStatus @default(PENDING)
  scheduledAt  DateTime          @map("scheduled_at")
  notes        String?
  deletedAt    DateTime?         @map("deleted_at")
  createdAt    DateTime          @default(now()) @map("created_at")
  updatedAt    DateTime          @updatedAt @map("updated_at")

  provider   User @relation("care_request_provider", fields: [providerId], references: [id], onDelete: Cascade)
  careSeeker User @relation("care_request_seeker", fields: [careSeekerId], references: [id], onDelete: Restrict)

  @@index([providerId])
  @@index([providerId, status])
  @@index([careSeekerId])
  @@map("care_requests")
}

model Review {
  id           String   @id @default(uuid()) @db.Uuid
  providerId   String   @db.Uuid
  careSeekerId String   @map("seekerId") @db.Uuid
  rating       Int
  comment      String?
  deletedAt    DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  provider   User @relation("review_provider", fields: [providerId], references: [id], onDelete: Cascade)
  careSeeker User @relation("review_seeker", fields: [careSeekerId], references: [id], onDelete: Restrict)

  @@index([providerId])
  @@index([careSeekerId])
  @@map("reviews")
}

model Notification {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  title     String
  body      String
  type      NotificationType
  readAt    DateTime?
  deletedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("notifications")
}

model ProviderVerification {
  id           String                           @id @default(uuid()) @db.Uuid
  providerId   String                           @map("provider_id") @db.Uuid
  documentType String                           @map("document_type")
  documentUrl  String                           @map("document_url")
  status       ProviderVerificationRecordStatus @default(PENDING)
  createdAt    DateTime                         @default(now()) @map("created_at")
  updatedAt    DateTime                         @updatedAt @map("updated_at")

  provider User @relation("provider_verification_provider", fields: [providerId], references: [id], onDelete: Cascade)

  @@index([providerId])
  @@map("provider_verifications")
}

model Payment {
  id             String        @id @db.Uuid
  userId         String        @db.Uuid
  subscriptionId String?       @db.Uuid
  amountCents    Int
  currency       String
  status         PaymentStatus
  description    String?
  paidAt         DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, status])
  @@map("payments")
}
