// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  SEEKER
  PROVIDER
  ADMIN
}

/// Provider verification state. Only relevant when role = PROVIDER.
/// Admins manage this via backend; never self-assignable.
enum ProviderVerificationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PresignupType {
  SEEKER
  PROVIDER
}

enum JobStatus {
  OPEN
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum NotificationType {
  GENERAL
  JOB
  MESSAGE
  PAYMENT
  REVIEW
}

enum SubscriptionStatus {
  INACTIVE
  ACTIVE
  PAST_DUE
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

/// Application-level user. Exists because Supabase auth.users only handles
/// authentication (identity). Roles, verification, and app-specific state
/// live here and are controlled server-side.
///
/// - id: Same UUID as Supabase auth.users.id (`@db.Uuid`). After migrating, run
///   `prisma/manual/supabase_user_fk.sql` on Supabase to add FK → auth.users(id).
/// - role: Application role; admin is NEVER self-assignable (enforced on create/update)
/// - providerVerificationStatus: For providers only; null for seeker/admin
model User {
  id                         String                     @id @db.Uuid // auth.users.id
  email                      String
  username                   String                     @unique
  name                       String
  surname                    String
  role                       UserRole                   @default(SEEKER)
  providerVerificationStatus ProviderVerificationStatus?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  jobs                    Job[]          @relation("SeekerJobs")
  savedProviders          SavedProvider[] @relation("SavedProvidersBySeeker")
  savedBySeekers          SavedProvider[] @relation("SavedProvidersByProvider")
  notifications           Notification[]
  sentMessages            Message[]      @relation("SentMessages")
  receivedMessages        Message[]      @relation("ReceivedMessages")
  writtenReviews          Review[]       @relation("SeekerReviews")
  receivedReviews         Review[]       @relation("ProviderReviews")
  subscriptions           Subscription[]
  payments                Payment[]
}

model Presignup {
  id       String        @id @default(cuid())
  type     PresignupType
  name     String
  surname  String
  email    String        @unique
  state    String?
  city     String?
  phone    String?
  accepted Boolean

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("presignups")
}

model Job {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  seekerId        String    @db.Uuid
  title           String
  description     String
  location        String?
  scheduledAt     DateTime?
  hourlyRateCents Int?
  status          JobStatus @default(OPEN)
  deletedAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  seeker User @relation("SeekerJobs", fields: [seekerId], references: [id], onDelete: Cascade)

  @@index([seekerId, status])
  @@index([seekerId, deletedAt])
  @@map("jobs")
}

model SavedProvider {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  seekerId   String   @db.Uuid
  providerId String   @db.Uuid
  createdAt  DateTime @default(now())

  seeker   User @relation("SavedProvidersBySeeker", fields: [seekerId], references: [id], onDelete: Cascade)
  provider User @relation("SavedProvidersByProvider", fields: [providerId], references: [id], onDelete: Cascade)

  @@unique([seekerId, providerId])
  @@index([providerId])
  @@map("saved_providers")
}

model Notification {
  id        String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String           @db.Uuid
  title     String
  body      String
  type      NotificationType @default(GENERAL)
  readAt    DateTime?
  deletedAt DateTime?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, deletedAt, createdAt])
  @@index([userId, readAt])
  @@map("notifications")
}

model Message {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  senderId          String   @db.Uuid
  recipientId       String   @db.Uuid
  body              String
  readAt            DateTime?
  senderDeletedAt   DateTime?
  recipientDeletedAt DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  sender    User @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  recipient User @relation("ReceivedMessages", fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([senderId, recipientId, createdAt])
  @@index([recipientId, readAt])
  @@map("messages")
}

model Review {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  seekerId   String   @db.Uuid
  providerId String   @db.Uuid
  rating     Int
  comment    String?
  deletedAt  DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  seeker   User @relation("SeekerReviews", fields: [seekerId], references: [id], onDelete: Cascade)
  provider User @relation("ProviderReviews", fields: [providerId], references: [id], onDelete: Cascade)

  @@unique([seekerId, providerId])
  @@index([providerId, deletedAt])
  @@map("reviews")
}

model Subscription {
  id         String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String             @db.Uuid
  planName   String
  status     SubscriptionStatus @default(INACTIVE)
  startedAt  DateTime?
  renewsAt   DateTime?
  canceledAt DateTime?
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  payments Payment[]

  @@unique([userId])
  @@map("subscriptions")
}

model Payment {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String        @db.Uuid
  subscriptionId String?       @db.Uuid
  amountCents    Int
  currency       String        @default("USD")
  status         PaymentStatus @default(PENDING)
  description    String?
  paidAt         DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscription Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([subscriptionId])
  @@map("payments")
}
