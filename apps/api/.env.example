# Required for Prisma and API startup
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/careseeker?schema=public

# Required for Supabase JWT verification (asymmetric projects)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Required for Supabase JWT verification (legacy HS256 projects)
SUPABASE_JWT_SECRET=

# Required for POST /seeker/register (admin Supabase auth operations)
SUPABASE_SECRET_KEY=

# Legacy fallback key name still supported by backend
SUPABASE_SERVICE_ROLE_KEY=

# Optional
PORT=2000
CORS_ORIGINS=
AUTH_DEBUG=false